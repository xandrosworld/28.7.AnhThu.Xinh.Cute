# Copy thành .env và thay SECRET_KEY bằng chuỗi ngẫu nhiên tối thiểu 32 byte.
SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=0
# Giữ 0 khi dùng migration (`flask db upgrade`). Chỉ đặt 1 cho demo
# create_all tự động trên một tệp SQLite hoàn toàn mới.
AUTO_INIT_DB=0

# Bỏ trống để dùng SQLite tại instance/dnp_wms.sqlite.
DATABASE_URL=

# Ví dụ SQL Server (ODBC Driver 18):
# DATABASE_URL=mssql+pyodbc://wms_user:password@localhost:1433/dnp_wms?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
